# Visora MVP — Environment Variables
# Copy to .env and fill in your values

# ── AI APIs (one of these is required for scanning) ──
OPENROUTER_API_KEY=       # Preferred in China: https://openrouter.ai
PERPLEXITY_API_KEY=       # Direct Perplexity API: https://www.perplexity.ai/settings/api
ANTHROPIC_API_KEY=        # For content generation: https://console.anthropic.com

# ── Supabase ─────────────────────────────────────────
SUPABASE_URL=             # From Supabase project Settings > API
SUPABASE_SERVICE_KEY=     # Service role key (keep secret!)
SUPABASE_ANON_KEY=        # Anon key (safe for frontend)

# ── App Config ───────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=           # https://resend.com

# ── Payments (Stripe, for v2) ────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
